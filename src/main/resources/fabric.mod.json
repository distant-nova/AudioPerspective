{
  "schemaVersion": 1,
  "id": "audio_perspective",
  "version": "${version}",
  "name": "AudioPerspective",
  "description": "Adds support for using a virtual listener position with Simple Voice Chat, independently of the physical player position.",
  "authors": [
    "distant-nova"
  ],
  "contact": {
    "sources": "https://github.com/distant-nova/AudioPerspective",
    "issues": "https://github.com/distant-nova/AudioPerspective/issues"
  },
  "license": "All Rights Reserved",
  "environment": "*",
  "entrypoints": {
    "main": [
      "de.distantnova.audioperspective.AudioPerspective"
    ],
    "client": [
      "de.distantnova.audioperspective.client.AudioPerspectiveClient"
    ]
  },
  "mixins": [
    "audio-perspective.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.19.3",
    "minecraft": "~26.2",
    "fabric-api": "*",
    "voicechat": "*"
  }
}
